rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function canAccessChatMessage() {
      return !resource.data.keys().hasAny(['conversationType']) ||
        resource.data.conversationType == 'team' ||
        request.auth.uid in resource.data.participants;
    }
    
    // ============================================
    // SECURITY: Require authentication on all operations
    // API key alone is NOT sufficient - must be signed in user
    // ============================================
    
    // CHAT - Authenticated users only
    match /chat_messages/{messageId} {
      // Team messages are available to authenticated users; direct messages are
      // visible only to their two participants. Existing legacy entries stay readable.
      allow read: if isSignedIn() && (
        !resource.data.keys().hasAny(['conversationType']) ||
        resource.data.conversationType == 'team' ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 && (
          (request.resource.data.conversationType == 'team' &&
           request.resource.data.participants.size() == 0) ||
          (request.resource.data.conversationType == 'direct' &&
           request.auth.uid in request.resource.data.participants &&
           request.resource.data.participants.size() == 2)
        );
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'readBy'])) ||
        isAdmin() ||
        (canAccessChatMessage() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']))
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // COMMUNICATIONS - Creators can create/read/update own; admins can do all
    match /comms_monitoring/{document} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'approver']
      );
      allow create: if isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'creator'];
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // USERS - role-bearing records are private. Do not expose roles/email via chat.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && isAdmin();
    }

    // A deliberately limited directory for direct-message recipient selection.
    match /chat_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['name', 'email', 'updatedAt']) &&
        request.resource.data.email == request.auth.token.email;
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    
    // METADATA - Admin only
    match /metadata/{document} {
      allow read, write: if isAdmin();
    }
  }
}
